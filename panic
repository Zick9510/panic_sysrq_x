#!/bin/bash
# ZPanic - lo lanza el módulo del kernel (SysRq) como root, sin tty de control.

# ----------------------------------------------------------------- configuración
LOCKFILE=/run/zpanic.lock
VTFILE=/run/zpanic.vt              # VT desde la que se activó el pánico
LOGFILE=/var/log/zpanic.log
PANIC_VT=63
PANIC_TTY=/dev/tty$PANIC_VT
ISOLATE=/usr/local/bin/isolate
CG=/sys/fs/cgroup
USER_SLICE=$CG/user.slice

AUTO_KILL=1                        # 1 = matar al mayor consumidor si falta memoria
MEM_FLOOR_KB=131072                # "falta memoria": avail + swap libre < 128 MiB
UID_MIN=1000 UID_MAX=59999         # usuarios "reales" (excluye nobody, DynamicUser...)

# --------------------------------------------------------------- estado global
FREEZE_MODE=none                   # none | cgroup | signal
FROZEN_UIDS=()
EMERGENCY=0
MEM_TOTAL=0 MEM_AVAIL=0 SWAP_FREE=0 PSI_FULL=0
VICTIM_PID= VICTIM_KB=0 VICTIM_NAME=
ORIGINAL_VT=1

# ---------------------------------------------------------------------- utilidades
# printf '%(...)T' es un builtin: loguear no hace fork.
log() { printf '%(%F %T)T %s\n' -1 "$*" >> "$LOGFILE" 2>/dev/null; }
say() { printf '%s\n' "$*"; log "$*"; }

# Escribe un valor en un fichero de /proc o /sys sin ruido si falla.
quiet_write() { { printf '%s\n' "$1" > "$2"; } 2>/dev/null; }

# Ejecuta un comando externo con límite de tiempo SIN depender de timeout(1):
# timeout espera a su hijo, y si el hijo está atascado en el kernel (estado D)
# timeout se atasca con él. Aquí lo dejamos en segundo plano y seguimos.
run_bounded() {                    # run_bounded SEGUNDOS comando args...
  local limit=$(( $1 * 5 )) i=0 pid
  shift
  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if (( ++i > limit )); then
      say "TIMEOUT: $* (sigue en segundo plano)"
      return 124
    fi
    sleep 0.2
  done
  wait "$pid"
}

# ----------------------------------------------------------------------- memoria
# Todo con 'read' sobre /proc: cero procesos nuevos.
read_mem() {
  local k v _
  while read -r k v _; do
    case $k in
      MemTotal:)     MEM_TOTAL=$v ;;
      MemAvailable:) MEM_AVAIL=$v ;;
      SwapFree:)     SWAP_FREE=$v ;;
    esac
  done < /proc/meminfo
}

# PSI ("pressure stall information"): % de tiempo (últimos 10 s) en que TODAS las
# tareas no paradas estuvieron esperando memoria. Detecta el thrashing aunque
# MemAvailable aún parezca sano (la caché que cuenta como "disponible" puede ser
# justo el working set).
read_psi() {
  local k a _
  PSI_FULL=0
  while read -r k a _; do
    [[ $k == full ]] && { a=${a#avg10=}; PSI_FULL=${a%%.*}; }
  done 2>/dev/null < /proc/pressure/memory
}

# Mayor consumidor de memoria ANÓNIMA entre los procesos de usuario (lo que
# realmente se libera al matarlo; RSS total incluiría librerías compartidas).
find_biggest_user() {
  local d key val _ uid anon name
  VICTIM_PID= VICTIM_KB=0 VICTIM_NAME=
  for d in /proc/[0-9]*; do
    uid= anon= name=
    while read -r key val _; do
      case $key in
        Name:)    name=$val ;;
        Uid:)     uid=$val ;;
        RssAnon:) anon=$val; break ;;
      esac
    done 2>/dev/null < "$d/status"
    [[ $uid && $anon ]] || continue
    (( uid >= UID_MIN && uid <= UID_MAX )) || continue
    if (( anon > VICTIM_KB )); then
      VICTIM_KB=$anon VICTIM_PID=${d#/proc/} VICTIM_NAME=$name
    fi
  done
  [[ $VICTIM_PID ]]
}

# Último recurso. Con los usuarios ya congelados sus páginas están "frías": si hay
# swap, el kernel las expulsa solo cuando haga falta. Si ni así queda margen
# (RAM disponible + swap libre), el shell de rescate no podría ni arrancar: se mata
# al mayor consumidor, de uno en uno, y se vuelve a medir.
relieve_memory() {
  (( AUTO_KILL )) || return 0
  local n
  for (( n = 0; n < 3; n++ )); do
    read_mem
    (( MEM_AVAIL + SWAP_FREE >= MEM_FLOOR_KB )) && return 0
    find_biggest_user || { say "Memoria baja y no hay procesos de usuario que matar."; return 0; }
    say "Memoria baja ($(( (MEM_AVAIL + SWAP_FREE) / 1024 )) MiB de margen): SIGKILL a '$VICTIM_NAME' (pid $VICTIM_PID, $(( VICTIM_KB / 1024 )) MiB anónimos)"
    kill -KILL "$VICTIM_PID" 2>/dev/null
    sleep 1
  done
}

# --------------------------------------------------------------------- congelado
# cgroup.freeze (cgroup v2, kernel >= 5.2) congela TODO el subárbol de golpe, en
# el kernel y de forma atómica: cubre contenedores rootless, procesos con UID
# raros y fork bombs (los hijos nacen ya congelados). No usa señales: no hay
# SIGCONT que reanude lo que el usuario había parado con Ctrl+Z.
wait_frozen() {
  local i k v
  for (( i = 0; i < 10; i++ )); do
    while read -r k v; do
      [[ $k == frozen && $v == 1 ]] && return 0
    done 2>/dev/null < "$USER_SLICE/cgroup.events"
    sleep 0.2
  done
  return 1
}

freeze_users() {
  if [[ -w $USER_SLICE/cgroup.freeze ]] && quiet_write 1 "$USER_SLICE/cgroup.freeze"; then
    FREEZE_MODE=cgroup
    if wait_frozen; then log "user.slice congelado"
    else log "user.slice: el kernel aún no confirma 'frozen' (¿procesos en estado D?)"; fi
    return 0
  fi

  # Plan B (cgroup v1/híbrido): SIGSTOP a todo lo de cada usuario con kill(-1)
  # ejecutado COMO ese usuario. El kernel recorre las tareas con tasklist_lock
  # tomado, así que fork() no puede añadir procesos a mitad: es (casi) atómico.
  FREEZE_MODE=signal
  local name _ uid
  while IFS=: read -r name _ uid _; do
    [[ $uid =~ ^[0-9]+$ ]] && (( uid >= UID_MIN && uid <= UID_MAX )) || continue
    # bash -c + builtin kill: el kill(1) externo varía entre distros (procps/util-linux)
    # y rechaza algunas formas ('--', '-s'); el builtin de bash es igual en todas.
    setpriv --reuid="$uid" --clear-groups -- bash -c 'kill -s STOP -1' 2>/dev/null ||
      log "plan B: no se pudo parar a los procesos del uid $uid"
    FROZEN_UIDS+=("$uid")
  done < /etc/passwd
  log "plan B: SIGSTOP a ${#FROZEN_UIDS[@]} usuarios"
}

thaw_users() {
  local uid
  case $FREEZE_MODE in
    cgroup) quiet_write 0 "$USER_SLICE/cgroup.freeze" ;;
    signal) for uid in "${FROZEN_UIDS[@]}"; do
              setpriv --reuid="$uid" --clear-groups -- bash -c 'kill -s CONT -1' 2>/dev/null ||
                log "no se pudo reanudar a los procesos del uid $uid"
            done ;;
  esac
  FREEZE_MODE=none
}

# --------------------------------------------------------------------- limpieza
# Todo lo que se deshace vive aquí: corre al terminar normalmente y también con
# INT/TERM/HUP. (Con SIGKILL no puede correr nada: por eso existe el protocolo
# "volver a pulsar la tecla", ver main.)
cleanup() {
  local rc
  trap - EXIT INT TERM HUP
  stty sane 2>/dev/null
  say "Restaurando..."
  run_bounded 120 "$ISOLATE" -da
  rc=$?
  thaw_users
  if (( rc )); then
    say "AVISO: 'isolate -da' devolvió $rc. El snapshot se conserva en /var/lib/isolate:"
    say "       repite 'isolate -da' cuando puedas."
    read -r -t 60 -p "Pulsa Enter para continuar... "
  fi
  run_bounded 5 chvt "$ORIGINAL_VT"
  log "=== ZPanic fin ==="
}

# ------------------------------------------------------------------------- main
main() {
  umask 077

  # 0) Autoprotección. Con -1000 el OOM killer nunca elige a este script (ni a lo
  #    que lance). Y lo sacamos del cgroup de usuario: así no puede congelarse a sí
  #    mismo si alguien lo prueba a mano desde su terminal (!), ni le afectan los
  #    límites de memoria de user.slice.
  quiet_write -1000 /proc/self/oom_score_adj
  quiet_write $$ "$CG/cgroup.procs"

  # 1) Una sola instancia (flock se libera solo si el script muere).
  exec 9>"$LOCKFILE"
  if ! flock -n 9; then
    run_bounded 5 chvt "$PANIC_VT"
    exit 0
  fi

  # Prioridad de tiempo real mientras trabajamos: un proceso que sature la CPU no
  # puede dejar sin turno al script. (El kernel reserva ~5% de CPU a lo normal.)
  chrt -f -p 50 $$ 2>/dev/null

  # 2) ¿Desde qué VT venimos? Si ya estamos en la 63 y el lock estaba libre, es que
  #    una instancia anterior murió: usamos la VT guardada y seguimos el ciclo
  #    completo (congelar es idempotente, isolate también), así la salida normal
  #    descongela y restaura todo.
  local tty_now
  read -r tty_now < /sys/class/tty/tty0/active
  ORIGINAL_VT=${tty_now#tty}
  if [[ $tty_now == "tty$PANIC_VT" ]]; then
    { read -r ORIGINAL_VT < "$VTFILE"; } 2>/dev/null
    [[ $ORIGINAL_VT =~ ^[0-9]+$ ]] || ORIGINAL_VT=1
    log "instancia previa muerta: recuperando (VT de vuelta: $ORIGINAL_VT)"
  else
    printf '%s\n' "$ORIGINAL_VT" > "$VTFILE"
  fi

  trap cleanup EXIT
  trap 'exit 1' INT TERM HUP

  log "=== ZPanic inicio (VT origen $ORIGINAL_VT) ==="

  # 3) ¿Emergencia de memoria? (poca RAM disponible, o PSI alto = thrashing)
  read_mem
  read_psi
  if (( MEM_TOTAL > 0 && MEM_AVAIL * 100 < MEM_TOTAL * 5 )) || (( PSI_FULL >= 10 )); then
    EMERGENCY=1
  fi
  log "mem: $MEM_AVAIL/$MEM_TOTAL kB disponibles, swap libre $SWAP_FREE kB, psi_full=$PSI_FULL%, emergencia=$EMERGENCY"

  # 4) Orden: en condiciones normales cambiamos de VT ANTES de congelar, para que el
  #    compositor aún pueda soltar la VT. En una emergencia de memoria manda parar la
  #    hemorragia: congelamos primero.
  if (( EMERGENCY )); then
    freeze_users
    run_bounded 5 chvt "$PANIC_VT"
  else
    run_bounded 5 chvt "$PANIC_VT"
    freeze_users
  fi

  exec < "$PANIC_TTY" > "$PANIC_TTY" 2>&1 || log "no se pudo abrir $PANIC_TTY"
  export TERM=linux HOME=/root
  stty sane 2>/dev/null
  clear

  # El banner sale ANTES del trabajo pesado: si ves esto, el pánico está vivo.
  printf '\e[31m\e[1m%s\e[0m\n' \
    "====================================" \
    "          ZPanic Activated          " \
    "===================================="
  say "Congelado: modo $FREEZE_MODE | memoria: $(( MEM_AVAIL / 1024 )) de $(( MEM_TOTAL / 1024 )) MiB, swap libre $(( SWAP_FREE / 1024 )) MiB, PSI full=${PSI_FULL}%"

  relieve_memory
  say "Mayores consumidores de memoria:"
  run_bounded 5 sh -c 'ps -eo pid,user:12,rss,comm --sort=-rss | head -n 6'

  # 5) Aislar componente a componente, cada uno con su límite de tiempo: si un
  #    disco colgado bloquea 'isolate -s', la red, el USB y los medios ya están hechos.
  #    (isolate hace sync() por su cuenta al desmontar.)
  say "Aislando..."
  run_bounded 30 "$ISOLATE" -n
  run_bounded 40 "$ISOLATE" -s
  run_bounded 20 "$ISOLATE" -u
  run_bounded 20 "$ISOLATE" -m

  # 6) Volvemos a prioridad normal: el shell de rescate no debe ser de tiempo real.
  chrt -o -p 0 $$ 2>/dev/null

  printf '\e[31m\e[1m%s\e[0m\n\n' "===================================="
  say "Shell de rescate (Ctrl-D para salir)"

  # tty explícita: sin argumento sulogin usa /dev/console, que puede apuntar a
  # otro sitio (p. ej. console=ttyS0).
  sulogin "$PANIC_TTY"
  log "sulogin terminó con código $?"
}

# Permite hacer 'source' del script en pruebas sin ejecutar el pánico.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
